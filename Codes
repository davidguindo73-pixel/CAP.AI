<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Cap AI — Make imagination look real.</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --lime: #C6FF3D;
    --lime-dim: #9FD12E;
    --bg: #000000;
    --bg-2: #0A0A0A;
    --bg-3: #111111;
    --border: #1c1c1c;
  }
  * { -webkit-font-smoothing: antialiased; }
  html, body { background: var(--bg); color: #fff; font-family: 'Inter', sans-serif; overflow-x: hidden; }
  .font-display { font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.03em; }
  .lime { color: var(--lime); }
  .bg-lime { background-color: var(--lime); }
  .border-lime { border-color: var(--lime); }
  .text-dim { color: #8a8a8a; }
  .text-mid { color: #b8b8b8; }

  /* Grain / Noise */
  body::before {
    content: "";
    position: fixed; inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.035;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* Glow cursor */
  .cursor-glow {
    position: fixed;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(198,255,61,0.12) 0%, rgba(198,255,61,0) 60%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 0;
    transition: opacity .4s;
    mix-blend-mode: screen;
  }

  /* Nav */
  .nav-glass {
    background: rgba(10,10,10,0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  /* Hero orb */
  .hero-orb {
    position: absolute;
    width: 900px; height: 900px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(198,255,61,0.35), rgba(198,255,61,0.05) 40%, rgba(0,0,0,0) 70%);
    filter: blur(60px);
    top: -30%;
    right: -20%;
    animation: float 14s ease-in-out infinite;
    pointer-events: none;
  }
  .hero-orb-2 {
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(198,255,61,0.18), rgba(0,0,0,0) 70%);
    filter: blur(80px);
    bottom: -200px;
    left: -150px;
    animation: float 18s ease-in-out infinite reverse;
    pointer-events: none;
  }
  @keyframes float {
    0%,100% { transform: translate(0,0) scale(1); }
    50% { transform: translate(-40px,30px) scale(1.08); }
  }

  /* Grid background */
  .grid-bg {
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }

  /* Buttons */
  .btn-lime {
    background: var(--lime);
    color: #000;
    font-weight: 600;
    padding: 14px 26px;
    border-radius: 999px;
    transition: all .3s cubic-bezier(.2,.8,.2,1);
    box-shadow: 0 0 0 0 rgba(198,255,61,0);
    position: relative;
    overflow: hidden;
  }
  .btn-lime:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px -10px rgba(198,255,61,0.6), 0 0 0 4px rgba(198,255,61,0.15);
  }
  .btn-ghost {
    border: 1px solid #2a2a2a;
    padding: 14px 26px;
    border-radius: 999px;
    transition: all .3s;
    color: #fff;
  }
  .btn-ghost:hover { border-color: var(--lime); color: var(--lime); }

  /* Cards */
  .feature-card {
    background: linear-gradient(180deg, #0e0e0e 0%, #080808 100%);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px;
    transition: all .4s cubic-bezier(.2,.8,.2,1);
    position: relative;
    overflow: hidden;
  }
  .feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(400px circle at var(--mx,50%) var(--my,0%), rgba(198,255,61,0.12), transparent 40%);
    opacity: 0;
    transition: opacity .4s;
    pointer-events: none;
  }
  .feature-card:hover { border-color: #333; transform: translateY(-4px); }
  .feature-card:hover::before { opacity: 1; }

  .feature-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: rgba(198,255,61,0.08);
    border: 1px solid rgba(198,255,61,0.2);
    display: flex; align-items: center; justify-content: center;
    color: var(--lime);
    margin-bottom: 20px;
  }

  /* Showcase tiles (simulated AI output) */
  .tile {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 3/4;
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
  }
  .tile:hover { transform: scale(1.02); }
  .tile-1 { background:
    radial-gradient(ellipse at 50% 30%, #2a1f14 0%, #0d0906 60%, #000 100%),
    linear-gradient(180deg, #1a1308, #000);
    background-blend-mode: screen;
  }
  .tile-2 { background:
    radial-gradient(ellipse at 30% 40%, #3a2e1a 0%, #0f0a05 60%, #000 100%),
    linear-gradient(135deg, #1f140a, #000);
    background-blend-mode: screen;
  }
  .tile-3 { background:
    radial-gradient(ellipse at 60% 30%, #1a2f2a 0%, #050d0b 60%, #000 100%),
    linear-gradient(180deg, #0a1f1a, #000);
    background-blend-mode: screen;
  }
  .tile-4 { background:
    radial-gradient(ellipse at 40% 50%, #2f1a2a 0%, #0d050a 60%, #000 100%),
    linear-gradient(180deg, #1a0a14, #000);
    background-blend-mode: screen;
  }
  .tile-5 { background:
    radial-gradient(ellipse at 50% 50%, #1f2a3a 0%, #050a0f 60%, #000 100%),
    linear-gradient(180deg, #0a1420, #000);
    background-blend-mode: screen;
  }
  .tile-6 { background:
    radial-gradient(ellipse at 70% 20%, #2a2a1a 0%, #0a0a05 60%, #000 100%),
    linear-gradient(180deg, #14140a, #000);
    background-blend-mode: screen;
  }
  .tile-7 { background:
    radial-gradient(ellipse at 30% 70%, #3a1f2a 0%, #0f050a 60%, #000 100%),
    linear-gradient(180deg, #1f0a14, #000);
    background-blend-mode: screen;
  }
  .tile-8 { background:
    radial-gradient(ellipse at 50% 40%, #1a3a2a 0%, #050f0a 60%, #000 100%),
    linear-gradient(180deg, #0a1f14, #000);
    background-blend-mode: screen;
  }
  .tile::after {
    content: "";
    position: absolute; inset: 0;
    background:
      radial-gradient(2px 2px at 20% 30%, rgba(255,255,255,0.25), transparent 50%),
      radial-gradient(1px 1px at 70% 60%, rgba(255,255,255,0.18), transparent 50%),
      radial-gradient(1.5px 1.5px at 40% 80%, rgba(255,255,255,0.15), transparent 50%),
      radial-gradient(1px 1px at 85% 20%, rgba(198,255,61,0.4), transparent 50%);
    pointer-events: none;
  }
  .tile-label {
    position: absolute; bottom: 16px; left: 16px; right: 16px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 12px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .tile-tag {
    position: absolute; top: 14px; left: 14px;
    background: rgba(198,255,61,0.9);
    color: #000;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Marquee */
  .marquee {
    display: flex;
    gap: 16px;
    animation: marquee 45s linear infinite;
  }
  .marquee:hover { animation-play-state: paused; }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .marquee .tile { flex: 0 0 280px; aspect-ratio: 3/4; }

  /* Tabs */
  .tab-btn {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: #0a0a0a;
    color: #b8b8b8;
    font-size: 14px;
    transition: all .3s;
    white-space: nowrap;
  }
  .tab-btn.active {
    background: var(--lime);
    color: #000;
    border-color: var(--lime);
    font-weight: 600;
  }
  .tab-btn:not(.active):hover { border-color: #444; color: #fff; }

  /* Stat card */
  .stat {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    background: #080808;
    position: relative;
    overflow: hidden;
  }
  .stat::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--lime), transparent);
    opacity: 0.6;
  }

  /* Pricing */
  .price-card {
    background: linear-gradient(180deg, #0d0d0d, #060606);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 36px;
    transition: all .4s;
  }
  .price-card.featured {
    border-color: var(--lime);
    position: relative;
    background:
      radial-gradient(circle at top, rgba(198,255,61,0.08), transparent 60%),
      linear-gradient(180deg, #0d0d0d, #060606);
  }
  .price-card:hover { transform: translateY(-6px); }

  /* Process step */
  .step {
    position: relative;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: #080808;
  }
  .step-num {
    font-family: 'Space Grotesk';
    font-size: 72px;
    font-weight: 700;
    color: var(--lime);
    line-height: 1;
    opacity: 0.18;
    position: absolute;
    top: 16px; right: 24px;
  }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(30px); transition: all .9s cubic-bezier(.2,.8,.2,1); }
  .reveal.in { opacity: 1; transform: translateY(0); }

  /* Prompt mockup */
  .prompt-mock {
    background: #0a0a0a;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px 20px;
    font-family: 'Space Grotesk', monospace;
    font-size: 14px;
    color: #d0d0d0;
    position: relative;
  }
  .prompt-mock::before {
    content: "PROMPT";
    position: absolute;
    top: -9px; left: 16px;
    background: var(--lime);
    color: #000;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .cursor-blink {
    display: inline-block;
    width: 2px; height: 1em;
    background: var(--lime);
    margin-left: 2px;
    animation: blink 1s infinite;
    vertical-align: middle;
  }
  @keyframes blink { 0%,50% { opacity: 1; } 51%,100% { opacity: 0; } }

  /* Logo mark */
  .logo-dot {
    width: 10px; height: 10px;
    background: var(--lime);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--lime);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%,100% { box-shadow: 0 0 12px var(--lime); }
    50% { box-shadow: 0 0 24px var(--lime), 0 0 6px var(--lime); }
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 10px; }
  ::-webkit-scrollbar-track { background: #000; }
  ::-webkit-scrollbar-thumb { background: #1c1c1c; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #2a2a2a; }

  /* Mobile menu */
  @media (max-width: 768px) {
    .hero-orb { width: 500px; height: 500px; right: -40%; }
    .mobile-nav-hide { display: none; }
  }
</style>
</head>
