<script>
  // Cursor glow
  const glow = document.getElementById('cursorGlow');
  document.addEventListener('mousemove', e => {
    glow.style.left = e.clientX + 'px';
    glow.style.top = e.clientY + 'px';
  });

  // Feature card spotlight
  document.querySelectorAll('.feature-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
      card.style.setProperty('--my', (e.clientY - rect.top) + 'px');
    });
  });

  // Reveal on scroll
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Stat counters
  const statObserver = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target;
        const target = parseInt(el.dataset.count, 10);
        const suffix = el.dataset.suffix || (target === 98 ? '%' : (target === 120 ? '' : ''));
        const isPercent = el.dataset.count === '98';
        const isK = el.dataset.count === '4';
        const isSec = el.dataset.suffix === 's';
        let cur = 0;
        const step = Math.max(1, Math.floor(target / 40));
        const iv = setInterval(() => {
          cur += step;
          if (cur >= target) { cur = target; clearInterval(iv); }
          el.textContent = cur + (isPercent ? '%' : (isK ? 'K' : (isSec ? 's' : '')));
        }, 30);
        statObserver.unobserve(el);
      }
    });
  }, { threshold: 0.4 });
  document.querySelectorAll('[data-count]').forEach(el => statObserver.observe(el));

  // Showcase tabs
  const showcaseData = {
    portrait: {
      prompt: 'studio portrait of a woman, golden hour window light, 85mm f/1.4, subtle freckles, soft skin texture, Kodak Portra 400 tones',
      tiles: [
        { cls: 'tile-1', tag: 'Portrait', label: 'Window light', time: '00:14' },
        { cls: 'tile-2', tag: 'Portrait', label: 'Golden hour', time: '00:11' },
        { cls: 'tile-3', tag: 'Portrait', label: 'Soft rim', time: '00:09' }
      ]
    },
    fashion: {
      prompt: 'fashion editorial, model in oversized leather jacket, Tokyo alley at midnight, neon reflections on wet pavement, 35mm grain',
      tiles: [
        { cls: 'tile-4', tag: 'Fashion', label: 'Neon noir', time: '00:18' },
        { cls: 'tile-5', tag: 'Fashion', label: 'Editorial', time: '00:15' },
        { cls: 'tile-6', tag: 'Fashion', label: 'Runway', time: '00:12' }
      ]
    },
    paparazzi: {
      prompt: 'nighttime paparazzi photo, harsh flash, celebrity leaving restaurant, motion blur background, film grain, candid energy',
      tiles: [
        { cls: 'tile-7', tag: 'Paparazzi', label: 'Flash burst', time: '00:08' },
        { cls: 'tile-1', tag: 'Paparazzi', label: 'Candid', time: '00:06' },
        { cls: 'tile-8', tag: 'Paparazzi', label: 'Street', time: '00:07' }
      ]
    },
    film: {
      prompt: 'cinematic short film scene, lone figure walking through rain-soaked market at dawn, anamorphic lens flares, dolly-in, 2.39:1',
      tiles: [
        { cls: 'tile-2', tag: 'Short film', label: 'Dawn scene', time: '00:24' },
        { cls: 'tile-3', tag: 'Short film', label: 'Rain market', time: '00:22' },
        { cls: 'tile-5', tag: 'Short film', label: 'Anamorphic', time: '00:26' }
      ]
    },
    wardrobe: {
      prompt: 'transform subject into haute couture gown, preserve face and pose exactly, silk texture, dramatic studio lighting, 8K detail',
      tiles: [
        { cls: 'tile-4', tag: 'Wardrobe', label: 'Gown swap', time: '00:10' },
        { cls: 'tile-6', tag: 'Wardrobe', label: 'Streetwear', time: '00:09' },
        { cls: 'tile-8', tag: 'Wardrobe', label: 'Haute', time: '00:11' }
      ]
    }
  };

  const grid = document.getElementById('showcaseGrid');
  const promptText = document.getElementById('promptText');

  function renderShowcase(key) {
    const d = showcaseData[key];
    grid.innerHTML = d.tiles.map(t => `
      <div class="tile ${t.cls}">
        <div class="tile-tag">${t.tag}</div>
        <div class="tile-label"><span>${t.label}</span><span class="lime">● ${t.time}</span></div>
      </div>
    `).join('');
    promptText.textContent = d.prompt;
  }
  renderShowcase('portrait');

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderShowcase(btn.dataset.tab);
    });
  });

  // Prompt Lab MVP: assemble a structured prompt without pretending to generate media.
  const capIdea = document.getElementById('capIdea');
  const capOutput = document.getElementById('capOutput');
  const capStyle = document.getElementById('capStyle');
  const capBuildPrompt = document.getElementById('capBuildPrompt');
  const capCopyPrompt = document.getElementById('capCopyPrompt');
  const capPromptStatus = document.getElementById('capPromptStatus');
  const capPromptResult = document.getElementById('capPromptResult');
  let capBuiltPrompt = '';

  if (capBuildPrompt) {
    capBuildPrompt.addEventListener('click', () => {
      const idea = capIdea.value.trim();
      if (!idea) {
        capPromptStatus.textContent = 'Add your idea first, then build your prompt.';
        capIdea.focus();
        return;
      }
      const medium = capOutput.value === 'video'
        ? 'Create a video with coherent motion, intentional camera movement, consistent subjects, and natural temporal continuity.'
        : 'Create a single image with a clear focal point, balanced composition, and fine detail.';
      capBuiltPrompt = idea + '\\n\\nStyle: ' + capStyle.value + '.\\n' + medium + '\\nAvoid: distorted anatomy, inconsistent details, unreadable text, excessive artifacts.';
      capPromptResult.textContent = capBuiltPrompt;
      capPromptResult.classList.remove('hidden');
      capCopyPrompt.disabled = false;
      capPromptStatus.textContent = 'Prompt ready. Copy it into a compatible image or video generator.';
    });
  }

  if (capCopyPrompt) {
    capCopyPrompt.addEventListener('click', async () => {
      if (!capBuiltPrompt) return;
      try {
        await navigator.clipboard.writeText(capBuiltPrompt);
        capPromptStatus.textContent = 'Prompt copied to clipboard.';
      } catch (err) {
        capPromptStatus.textContent = 'Clipboard access was blocked. Select the prompt above and copy it manually.';
      }
    });
  }

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const id = a.getAttribute('href');
      if (id.length > 1) {
        const el = document.querySelector(id);
        if (el) {
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>

