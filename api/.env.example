# Copy these into your backend host's Environment settings. Never commit real keys.
PORT=8787
NODE_ENV=production
# Comma-separated allowed website origins (origins have no path).
CORS_ORIGINS=https://davidguindo73-pixel.github.io,http://localhost:5500,http://127.0.0.1:5500

# Existing media-generation gateway (Higgsfield).
# Option A: private single-owner preview using a server-side provider key.
# HF_API_KEY=YOUR_HIGGSFIELD_API_KEY
# CAP_API_ACCESS_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
# Option B: leave both unset and use a provider key per browser session (BYOK).

# New AI advertising strategy engine.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_AD_MODEL=gpt-4.1-mini
CAP_ADS_ACCESS_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Optional PostgreSQL database for persistent campaign workspaces.
# Without DATABASE_URL, campaigns are held in process memory and lost on restart.
# DATABASE_URL=YOUR_POSTGRES_CONNECTION_STRING
# DATABASE_SSL=true

# API keys and access tokens must stay in the backend host's secret environment,
# never in GitHub Pages HTML/JavaScript or committed files.
