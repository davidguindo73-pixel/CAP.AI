# Copy these into your backend host's Environment settings. Never commit real keys.
PORT=8787
NODE_ENV=production
# Comma-separated allowed website origins (origins have no path).
CORS_ORIGINS=https://davidguindo73-pixel.github.io,http://localhost:5500,http://127.0.0.1:5500
# Option A: single-owner/private prototype. Add a server-side provider key AND a long random app token.
# HF_API_KEY=YOUR_HIGGSFIELD_API_KEY
# CAP_API_ACCESS_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
# Option B: BYOK prototype. Leave both above unset; each user enters their own key for each session.
# API key values are never written to logs or saved in the browser by CAP.AI.
