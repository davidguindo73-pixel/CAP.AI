# Copy these into the backend host's Environment settings. Never commit real keys.
PORT=8787
NODE_ENV=production
CORS_ORIGINS=https://davidguindo73-pixel.github.io,http://localhost:5500,http://127.0.0.1:5500
CAP_FRONTEND_URL=https://davidguindo73-pixel.github.io/CAP.AI

# Existing image/video provider (Higgsfield).
# Use either BYOK from the browser or configure both server values for a private owner deployment.
# HF_API_KEY=
# CAP_API_ACCESS_TOKEN=

# AI campaign strategy and the CAP.AI GPT Image generator (required for those features).
OPENAI_API_KEY=
OPENAI_AD_MODEL=gpt-4.1-mini
CAP_ADS_ACCESS_TOKEN=

# PostgreSQL is required for customer registration, sessions, business profiles and integrations.
DATABASE_URL=
DATABASE_SSL=true

# Generate a dedicated random key for encrypting customer OAuth tokens at rest.
# Example: openssl rand -hex 32
# Do not rotate this key without first decrypting/re-encrypting stored provider tokens.
CAP_TOKEN_ENCRYPTION_KEY=

# Meta Marketing API (optional until the Meta app is created and approved).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://cap-ai-generation-api.onrender.com/api/integrations/meta/callback
# Set to a currently supported Graph API version in Meta's developer dashboard.
META_GRAPH_API_VERSION=v27.0
META_OAUTH_SCOPES=ads_read,ads_management,business_management,pages_show_list,pages_read_engagement,pages_manage_ads

# Google Ads API (optional until OAuth and API access are configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cap-ai-generation-api.onrender.com/api/integrations/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26
# Optional when using a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# TikTok For Business Marketing API (optional).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Copy the advertiser authorization URL generated by your TikTok Business API app.
TIKTOK_ADVERTISER_AUTH_URL=
TIKTOK_REDIRECT_URI=https://cap-ai-generation-api.onrender.com/api/integrations/tiktok/callback
TIKTOK_API_VERSION=v2.0

# Stripe subscriptions (optional until live/test prices and webhook are configured).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
